# When connecting to a real Supabase backend, set these values.
# Copy this file to .env.local and fill in your project credentials.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Set to "mock" to use the in-memory mock repository (default in development)
# Set to "supabase" to use the real Supabase repository
VITE_API_ADAPTER=mock
